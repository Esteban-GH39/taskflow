# Copia este archivo a .env para desarrollo local
PORT=4000
# Obligatorio en produccion. Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo
# URL(s) del frontend permitidas, separadas por coma. Usa * solo en desarrollo.
CORS_ORIGIN=http://localhost:5173
# Ruta del archivo SQLite (en produccion apunta a un disco persistente)
DB_PATH=./data/taskflow.db
# Opcional: carpeta del frontend compilado para servirlo desde el mismo servidor
# STATIC_DIR=../frontend/dist
